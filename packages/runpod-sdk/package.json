{
  "name": "runpod-sdk",
  "version": "1.1.2",
  "description": "JavaScript and TypeScript SDK for Runpod: the REST v2 API client and the Serverless job client",
  "license": "MIT",
  "author": "Runpod",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "runpod",
    "gpu",
    "serverless",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runpod/js-sdk.git",
    "directory": "packages/runpod-sdk"
  },
  "bugs": {
    "url": "https://github.com/runpod/js-sdk/issues"
  },
  "homepage": "https://github.com/runpod/js-sdk#readme",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@runpod/typescript-api-sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
